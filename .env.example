# Copy this file to .env and replace every placeholder locally.
# Required exact value: development, test, demo, staging, or production.
# This development value is intentionally unsuitable for an inferred deployment;
# staging and production must be selected explicitly.
APP_ENV=development

# Required by FastAPI, the Telegram runner, and manual migration commands.
DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@localhost:5432/aura

# Required only when APP_ENV=demo. This database must be separate from
# DATABASE_URL, and its database name must contain "demo".
DEMO_DATABASE_URL=postgresql+psycopg://demo_user:change-me@localhost:5432/aura_demo

# Required only when APP_ENV=demo. Server-only credential for the portfolio
# BFF; never expose it through NEXT_PUBLIC_* or browser-delivered code.
DEMO_BFF_SERVICE_TOKEN=REPLACE_WITH_RANDOM_BFF_SERVICE_TOKEN_32_TO_512_CHARACTERS

# PostgreSQL integration tests are launched only by the guarded Windows runner.
# Do not store TEST_DATABASE_URL here or manually interpolate a password into it.
# See deploy/windows/README.md for the protected test-only pgpass workflow.

# FastAPI authentication only. This deliberately invalid placeholder is rejected.
# Use 32-512 random characters without surrounding whitespace or controls.
AUTH_JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_32_TO_512_CHARACTERS
# Development/test defaults. Demo, staging, and production require explicit,
# non-development issuer and audience values.
AUTH_JWT_ISSUER=aura
AUTH_JWT_AUDIENCE=aura-api
# Strict integer from 1 to 1440 minutes.
AUTH_JWT_EXPIRE_MINUTES=60

# Keep false outside short-lived local SQL diagnostics; true may expose query data.
SQL_ECHO=false

# Telegram local long-polling runner. These are required only by
# `python -m app.integrations.telegram.runner`, never by the FastAPI process.
TELEGRAM_BOT_TOKEN=REPLACE_WITH_TELEGRAM_BOT_TOKEN
# Use 32-512 random non-whitespace characters, no controls; keep stable because
# changing the secret or HMAC derivation version breaks the Telegram mapping.
TELEGRAM_IDENTITY_SECRET=REPLACE_WITH_RANDOM_TELEGRAM_IDENTITY_SECRET
TELEGRAM_CLEAR_WEBHOOK_ON_START=false
TELEGRAM_DROP_PENDING_UPDATES=false
# Strict integer from 1 to 60 seconds.
TELEGRAM_POLL_TIMEOUT_SECONDS=30

# Optional Phase E outbound notification. The recipient is runner-only and is
# never read from customer input or persisted in the outbox.
TELEGRAM_OWNER_NOTIFICATIONS_ENABLED=false
# Optional Phase F ticket-management commands. This flag is independent from
# owner notifications and is disabled by default.
TELEGRAM_OWNER_COMMANDS_ENABLED=false
# Required when owner notifications or owner commands are enabled; use a
# positive private Telegram user/chat ID.
TELEGRAM_OWNER_CHAT_ID=REPLACE_WITH_PRIVATE_OWNER_CHAT_ID
# Strict bounded integers: poll 1-300, attempts 1-20, retry 1-3600,
# lease 5-3600 seconds.
TELEGRAM_OWNER_NOTIFICATION_POLL_SECONDS=5
TELEGRAM_OWNER_NOTIFICATION_MAX_ATTEMPTS=5
TELEGRAM_OWNER_NOTIFICATION_RETRY_BASE_SECONDS=10
TELEGRAM_OWNER_NOTIFICATION_LEASE_SECONDS=60

# FastAPI and Telegram runner require one exact provider: ollama or openai.
# Unknown values fail startup and never fall back silently.
AI_PROVIDER=ollama
# Demo/staging/production permit plaintext HTTP only for loopback Ollama.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:3b
OPENAI_MODEL=gpt-5
# Required only when AI_PROVIDER=openai. This placeholder is invalid by design.
OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY_IF_USED
