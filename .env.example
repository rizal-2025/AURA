# Copy this file to .env and replace every placeholder locally.
DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@localhost:5432/aura

# Optional: dedicated disposable PostgreSQL database for integration tests only.
# It must not resolve to DATABASE_URL, and its database name must contain "test".
TEST_DATABASE_URL=postgresql+psycopg://TEST_USERNAME:TEST_PASSWORD@localhost:5432/aura_test

# At least 32 random characters. Generate locally; never commit the real value.
AUTH_JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
AUTH_JWT_ISSUER=aura
AUTH_JWT_AUDIENCE=aura-api
# Strict integer from 1 to 1440 minutes.
AUTH_JWT_EXPIRE_MINUTES=60

# Keep false outside short-lived local SQL diagnostics; true may expose query data.
SQL_ECHO=false

# Optional Telegram local long-polling runner. These are required only by
# `python -m app.integrations.telegram.runner`, never by the FastAPI process.
TELEGRAM_BOT_TOKEN=REPLACE_WITH_YOUR_BOTFATHER_TOKEN
# At least 32 random non-whitespace characters, no controls; keep stable because
# changing the secret or HMAC derivation version breaks the Telegram mapping.
TELEGRAM_IDENTITY_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
TELEGRAM_CLEAR_WEBHOOK_ON_START=false
TELEGRAM_DROP_PENDING_UPDATES=false
# Strict integer from 1 to 60 seconds.
TELEGRAM_POLL_TIMEOUT_SECONDS=30

# Optional Phase E outbound notification. The recipient is runner-only and is
# never read from customer input or persisted in the outbox.
TELEGRAM_OWNER_NOTIFICATIONS_ENABLED=false
# Optional Phase F ticket-management commands. This flag is independent from
# owner notifications and is disabled by default.
TELEGRAM_OWNER_COMMANDS_ENABLED=false
# Required when owner notifications or owner commands are enabled; use a
# positive private Telegram user/chat ID.
TELEGRAM_OWNER_CHAT_ID=REPLACE_WITH_PRIVATE_OWNER_CHAT_ID
# Strict bounded integers: poll 1-300, attempts 1-20, retry 1-3600,
# lease 5-3600 seconds.
TELEGRAM_OWNER_NOTIFICATION_POLL_SECONDS=5
TELEGRAM_OWNER_NOTIFICATION_MAX_ATTEMPTS=5
TELEGRAM_OWNER_NOTIFICATION_RETRY_BASE_SECONDS=10
TELEGRAM_OWNER_NOTIFICATION_LEASE_SECONDS=60

# Choose one provider. Keep API keys out of version control.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:3b
OPENAI_MODEL=gpt-5
OPENAI_API_KEY=REPLACE_WITH_YOUR_OPENAI_API_KEY_IF_USED
